# Same Postgres instance as the Spring Boot backend.
DATABASE_URL=postgresql://codepulse:codepulse@localhost:5432/codepulse

# RS256 public key used by Spring to sign JWTs (backend/src/main/resources/public.key).
JWT_PUBLIC_KEY_PATH=../backend/src/main/resources/public.key
JWT_ISSUER=codepulse-dev

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

LLM_API_KEY=
LLM_MODEL_NAME=gpt-4o-mini
LLM_API_BASE_URL=https://api.openai.com/v1

SERVICE_PORT=8090
LOG_LEVEL=INFO
