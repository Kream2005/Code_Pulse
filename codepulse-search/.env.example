# Same Postgres instance as the Spring Boot backend.
DATABASE_URL=postgresql://codepulse:codepulse@localhost:5432/codepulse

# RS256 public key used by Spring (copy/generate with the backend on this machine).
# Relative to the codepulse-search/ folder — works on Windows and Linux.
JWT_PUBLIC_KEY_PATH=../backend/src/main/resources/public.key
JWT_ISSUER=codepulse-dev

# Embeddings (open source, CPU-friendly). Offline: unzip models/all-MiniLM-L6-v2-local.zip
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=./models/all-MiniLM-L6-v2-local

# Local LLM via Ollama (required for polished assistant answers, not for search/KPI).
# Install Ollama, then: ollama pull llama3.2:1b
# If download blocked on Windows: copy Linux ~/.ollama/models or snap /var/snap/ollama/common/models
LLM_PROVIDER=ollama
LLM_API_KEY=ollama
LLM_MODEL_NAME=llama3.2:1b
LLM_API_BASE_URL=http://127.0.0.1:11434/v1

SERVICE_PORT=8090
LOG_LEVEL=INFO

# Continuous learning: index new/changed Spring rows + knowledge docs automatically.
AUTO_INGEST_ENABLED=true
AUTO_INGEST_INTERVAL_SECONDS=120
